# 生产环境：需填写真实接口地址（支持跨域）
# 咪咕（暂不启用：接口无图片且不稳定，留空则不启用）
# VITE_MIGU_API_BASE=https://api.xcvts.cn/api/music/migu

# 网易云（必填）
VITE_NETEASE_API_BASE=https://api.vkeys.cn/v2/music/netease

# 歌词代理（选填，留空走 fallback）
VITE_LRC_PROXY_BASE=

# 封面图片代理（选填，留空走 fallback）
VITE_IMG_PROXY_BASE=

# QQ音乐（选填，留空不启用）
VITE_QQ_API_BASE=https://tang.api.s01s.cn/music_open_api.php
VITE_QQ_API_KEY=

# 酷我（选填，留空不启用）
VITE_KUWO_API_BASE=https://kw-api.cenguigui.cn/
